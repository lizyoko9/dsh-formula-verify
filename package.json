{
  "name": "dsh-formula-verify",
  "version": "0.4.2",
  "description": "Formula verification skill, Formula Lab panel and SymPy CLI for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/lab.js",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "icon.svg",
    "locale/*.json"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "formula",
    "sympy",
    "verification"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "icon": "./icon.svg"
}
